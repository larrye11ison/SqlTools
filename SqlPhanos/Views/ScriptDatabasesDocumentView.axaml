<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SqlPhanos.ViewModels"
             xmlns:sdb="using:SqlPhanos.ScriptDatabases"
             xmlns:conv="using:Avalonia.Data.Converters"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="600"
             x:Class="SqlPhanos.Views.ScriptDatabasesDocumentView"
             x:DataType="vm:ScriptDatabasesDocumentViewModel">

    <Design.DataContext>
        <vm:ScriptDatabasesDocumentViewModel/>
    </Design.DataContext>

    <Grid>
        <DockPanel Margin="12">
            <DockPanel.IsEnabled>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!PendingEncryptedConsent"/>
                    <Binding Path="!PendingOutputConflict"/>
                </MultiBinding>
            </DockPanel.IsEnabled>
            <!-- Output directory -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Left"
                           Text="Output folder:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <Button DockPanel.Dock="Right" Content="Browse..." Click="OnBrowseClick" Margin="8,0,0,0"/>
                <TextBox x:Name="OutputDirectoryBox" Text="{Binding BaseOutputDirectory}"/>
            </DockPanel>

            <CheckBox DockPanel.Dock="Top"
                      Content="Reformat All SQL Code"
                      IsChecked="{Binding ReformatSqlCode}"
                      ToolTip.Tip="Run every scripted object through SqlPhanos's SQL formatter before writing it to disk"
                      Margin="0,0,0,8"/>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,8">
                <CheckBox Content="Normalize Auto-Generated Constraint Names (For comparison only)"
                          IsChecked="{Binding NormalizeAutoGeneratedNames}"/>
                <Button Content="?"
                        Width="20" Height="20" Padding="0" CornerRadius="10"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        VerticalAlignment="Center"
                        ToolTip.Tip="What does this do?">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <StackPanel Width="440" Spacing="8" Margin="4">
                                <TextBlock Text="Normalize Auto-Generated Constraint Names" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="When SQL Server creates a PRIMARY KEY, UNIQUE, FOREIGN KEY, DEFAULT, or CHECK constraint without an explicit name, it invents one that includes a hash-like suffix - e.g. "/>
                                    <Run Text="PK__Orders__3213E83F1A2B3C4D" FontFamily="Consolas,monospace"/>
                                    <Run Text=". That suffix is different every time the constraint is dropped and recreated, even if nothing about it actually changed - which produces a false-positive difference every night for tables that get rebuilt on a schedule."/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="With this option checked, any constraint name matching that auto-generated shape is rewritten to a deterministic name built from the constraint's own columns instead - e.g. "/>
                                    <Run Text="PK_Orders_OrderID" FontFamily="Consolas,monospace"/>
                                    <Run Text=". The same constraint gets the same name every time you script it, so it stops showing up as a difference. Constraint names you (or a prior developer) actually chose on purpose are left untouched - only names matching SQL Server's own auto-generated pattern are affected."/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="CHECK constraints are handled slightly differently: a CHECK doesn't have one single &quot;owning&quot; column the way a key does, so its new name is built from every column referenced inside the CHECK expression instead (sorted, so it's still deterministic)."/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontStyle="Italic">
                                    <Run Text="Only the constraint's NAME is changed in the script file this tool writes - its definition, columns, and behavior are untouched, and nothing is ever renamed on the actual SQL Server. This is a heuristic for reducing comparison noise, not a guarantee."/>
                                </TextBlock>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <!-- Commands -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <Button Content="Check All" Command="{Binding CheckAllCommand}"/>
                <Button Content="Uncheck All" Command="{Binding UncheckAllCommand}"/>
                <Button Content="Script" Command="{Binding ScriptCommand}" Classes="accent"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}"/>
            </StackPanel>

            <!-- Overall status -->
            <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" IsVisible="{Binding !IsInErrorState}"/>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="IndianRed" IsVisible="{Binding IsInErrorState}"/>
                <TextBlock Text="{Binding DurationText}" FontSize="11" Opacity="0.7" IsVisible="{Binding IsRunning}"/>
                <ProgressBar Minimum="0" Maximum="100" Height="10"
                             Value="{Binding OverallProgressPercent}"
                             IsVisible="{Binding IsRunning}"/>
            </StackPanel>

            <!-- Database list -->
            <ListBox ItemsSource="{Binding Databases}" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="sdb:DatabaseListItem">
                        <Grid ColumnDefinitions="Auto,2*,3*" Margin="0,2">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsSelected}"
                                      IsEnabled="{Binding CanChangeSelection}"
                                      VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       Margin="4,0"/>
                            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                <ProgressBar Minimum="0" Maximum="100" Height="10"
                                             Value="{Binding ProgressPercent}"
                                             IsVisible="{Binding ShowProgressBar}"/>
                                <TextBlock Text="{Binding ProgressStatus}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding HasProgressStatus}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Encrypted-module decrypt consent overlay - a real security-relevant gate (opens a
             DAC connection, requires sysadmin), shown in-tab rather than as a modal dialog. -->
        <Grid IsVisible="{Binding PendingEncryptedConsent}" Background="#80000000">
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="420">
                <StackPanel Spacing="8">
                    <TextBlock Text="Encrypted modules detected" FontWeight="Bold" FontSize="16"/>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{Binding PendingEncryptedDatabaseName}"/>
                        <Run Text=" has "/>
                        <Run Text="{Binding PendingEncryptedCount}"/>
                        <Run Text=" encrypted module(s) (WITH ENCRYPTION). Decrypting requires opening a Dedicated Administrator Connection (DAC / ADMIN:) and requires sysadmin (or equivalent) - for remote instances, 'remote admin connections' must be enabled. Nothing is altered or dropped on the server."/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
                        <Button Command="{Binding ConfirmDecryptCommand}" Content="Decrypt" Classes="accent"/>
                        <Button Command="{Binding DeclineDecryptCommand}" Content="Skip"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Output-folder-already-has-content overlay. Delta is the default choice - it's both
             the visually primary (accent) button and IsDefault="True", so hitting Enter while
             this is showing proceeds with Delta, per explicit requirement. -->
        <Grid IsVisible="{Binding PendingOutputConflict}" Background="#80000000">
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="480">
                <StackPanel Spacing="8">
                    <TextBlock Text="Output folder already has content" FontWeight="Bold" FontSize="16"/>
                    <TextBlock TextWrapping="Wrap"
                               Text="One or more of the selected databases' output folders already contain files:"/>
                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            Padding="8"
                            MaxHeight="120">
                        <ScrollViewer>
                            <TextBlock Text="{Binding PendingOutputConflictFolders}" TextWrapping="Wrap" FontFamily="Consolas,monospace" FontSize="11"/>
                        </ScrollViewer>
                    </Border>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Delta only re-scripts objects that changed since they were last scripted (based on SQL Server's create/modify metadata). Reset first clears those folders, then does a full script of everything. Cancel does nothing."/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
                        <Button Command="{Binding ChooseDeltaCommand}" Content="Delta" Classes="accent" IsDefault="True"/>
                        <Button Command="{Binding ChooseResetCommand}" Content="Reset first"/>
                        <Button Command="{Binding ChooseCancelConflictCommand}" Content="Cancel" IsCancel="True"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

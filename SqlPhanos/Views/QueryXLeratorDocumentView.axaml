<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SqlPhanos.ViewModels"
             xmlns:editor="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="SqlPhanos.Views.QueryXLeratorDocumentView"
             x:DataType="vm:QueryXLeratorDocumentViewModel">

    <Design.DataContext>
        <vm:QueryXLeratorDocumentViewModel/>
    </Design.DataContext>

    <Grid>
        <DockPanel IsEnabled="{Binding IsContentInteractive}">
            <!-- Header / toolbar -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource SystemAccentColor}"
                    Padding="12,8">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Title}"
                               FontWeight="SemiBold"
                               FontSize="14"/>

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="Output:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding OutputPath}"/>
                        <Button Grid.Column="2"
                                Content="Browse..."
                                Click="OnBrowseClick"
                                Margin="6,0,0,0"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Table style:" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding TableStyleNames}"
                                  SelectedItem="{Binding SelectedTableStyleName}"
                                  MinWidth="150"/>
                        <CheckBox Content="Include empty result sets"
                                  IsChecked="{Binding IncludeEmptyResultSets}"
                                  VerticalAlignment="Center"/>
                        <Button Content="Reformat"
                                Command="{Binding ReformatCommand}"
                                ToolTip.Tip="Reformat the query text (Ctrl+M)"/>
                        <Button Content="Execute"
                                Command="{Binding ExecuteCommand}"
                                IsEnabled="{Binding CanRunQuery}"/>
                        <Button Content="Cancel"
                                Command="{Binding CancelCommand}"
                                IsVisible="{Binding IsRunning}"/>
                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DurationText}" VerticalAlignment="Center" Opacity="0.8"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <editor:TextEditor x:Name="Editor"
                               ShowLineNumbers="True"
                               WordWrap="False"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"/>
        </DockPanel>

        <!-- Overwrite confirmation overlay -->
        <Grid IsVisible="{Binding ShowOverwriteConfirmation}" Background="#80000000">
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="420">
                <StackPanel Spacing="6">
                    <TextBlock Text="Overwrite file?" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Text="{Binding OutputPath, StringFormat='The output file already exists:\n{0}'}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="Overwrite" Command="{Binding ConfirmOverwriteCommand}" Classes="accent"/>
                        <Button Content="Cancel" Command="{Binding CancelOverwriteCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Formatting safety-check warning overlay: SqlCanonicalizationService re-verifies its
             own output before returning it and falls back to leaving QueryText unchanged rather
             than risk handing back corrupted SQL - see SqlCanonicalizationService.IsRoundTripSafe.
             This must be surfaced, not silently swallowed, so the user knows to report it. -->
        <Grid IsVisible="{Binding PendingFormattingSafetyWarning}" Background="#80000000">
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="420">
                <StackPanel Spacing="8">
                    <TextBlock Text="Formatting was skipped" FontWeight="Bold" FontSize="16"/>
                    <TextBlock TextWrapping="Wrap"
                               Text="The formatter's own safety check found that reformatting this query would not have reproduced the same SQL, so the text was left unchanged. Nothing was changed or lost - please report this so the formatter bug can be fixed."/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Command="{Binding DismissFormattingSafetyWarningCommand}" Content="OK" Classes="accent" IsDefault="True"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Closing this tab (X, Ctrl+W, the Close Document menu item) while a run is in progress
             would otherwise silently abandon it - see QueryXLeratorDocumentViewModel.OnClose. -->
        <Grid IsVisible="{Binding PendingCloseConfirmation}" Background="#80000000">
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="420">
                <StackPanel Spacing="8">
                    <TextBlock Text="Export is still running" FontWeight="Bold" FontSize="16"/>
                    <TextBlock TextWrapping="Wrap"
                               Text="Closing this tab will cancel the export in progress. Close anyway?"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
                        <Button Command="{Binding ConfirmCloseCommand}" Content="Cancel &amp; Close" Classes="accent"/>
                        <Button Command="{Binding KeepWorkingCommand}" Content="Keep Working" IsDefault="True" IsCancel="True"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>

</UserControl>

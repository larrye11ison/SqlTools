<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SqlPhanos.ViewModels"
        xmlns:views="using:SqlPhanos.Views"
        xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
        xmlns:enums="using:SqlPhanos.Enums"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="SqlPhanos.Views.ShellView"
        x:DataType="vm:ShellViewModel"
        Icon="/Assets/sqlphanos.ico"
        Title="{Binding AppTitle}"
        Width="1200"
        Height="800">

    <Design.DataContext>
        <vm:ShellViewModel/>
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding ExecuteShortcutCommand}" CommandParameter="{x:Static enums:ApplicationShortcut.Find}" />
        <KeyBinding Gesture="Ctrl+Tab" Command="{Binding ExecuteShortcutCommand}" CommandParameter="{x:Static enums:ApplicationShortcut.NextDocument}" />
        <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding ExecuteShortcutCommand}" CommandParameter="{x:Static enums:ApplicationShortcut.PreviousDocument}" />
    </Window.KeyBindings>
    <!-- Ctrl+Shift+P is wired in code-behind (handledEventsToo) rather than as a declarative
         KeyBinding here, since a descendant such as the AvaloniaEdit editor or the search
         results DataGrid can mark the key event Handled before it would otherwise bubble up
         to a Window-level KeyBinding. -->

    <DockPanel>
        <!-- Main menu bar. No actively-maintained, stable ribbon control targeting this
             Avalonia version was found (the available options are pre-1.0/beta packages or a
             commercial suite), so this uses a classic Windows-style menu instead. -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Settings..." Click="OnSettingsClick"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="OnExitClick"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Toggle _Formatting" InputGesture="Ctrl+M" Click="OnToggleFormattingClick"/>
                <MenuItem Header="_Find in Document" InputGesture="Ctrl+F" Click="OnFindClick"/>
                <MenuItem Header="Focus _Search Box" InputGesture="Ctrl+Shift+F" Command="{Binding ExecuteShortcutCommand}" CommandParameter="{x:Static enums:ApplicationShortcut.Find}"/>
                <MenuItem Header="Cycle _Pane Focus" InputGesture="Ctrl+Shift+P" Click="OnCyclePaneClick"/>
            </MenuItem>
            <MenuItem Header="_Document">
                <MenuItem Header="_Next Document" InputGesture="Ctrl+Tab" Command="{Binding ExecuteShortcutCommand}" CommandParameter="{x:Static enums:ApplicationShortcut.NextDocument}"/>
                <MenuItem Header="_Previous Document" InputGesture="Ctrl+Shift+Tab" Command="{Binding ExecuteShortcutCommand}" CommandParameter="{x:Static enums:ApplicationShortcut.PreviousDocument}"/>
                <Separator/>
                <MenuItem Header="_Close Document" InputGesture="Ctrl+W" Click="OnCloseDocumentClick"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About SqlPhanos..." Click="OnAboutClick"/>
            </MenuItem>
        </Menu>

        <!-- Status bar at bottom -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SystemAccentColor}"
                Padding="8,4">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Name="SettingsButton"
                        Content="⚙ Settings"
                        Click="OnSettingsClick"
                        Padding="6,2"
                        FontSize="12"/>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Main content area -->
        <dock:DockControl Layout="{Binding Layout}" />
    </DockPanel>

</Window>

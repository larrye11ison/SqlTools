<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SqlPhanos.ViewModels"
        xmlns:views="using:SqlPhanos.Views"
        xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
        xmlns:enums="using:SqlPhanos.Enums"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="SqlPhanos.Views.ShellView"
        x:DataType="vm:ShellViewModel"
        Icon="/Assets/sqlphanos.ico"
        Title="{Binding AppTitle}"
        Width="1200"
        Height="800">

    <Design.DataContext>
        <vm:ShellViewModel/>
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding ExecuteShortcutCommand}" CommandParameter="{x:Static enums:ApplicationShortcut.Find}" />
        <KeyBinding Gesture="Ctrl+Tab" Command="{Binding ExecuteShortcutCommand}" CommandParameter="{x:Static enums:ApplicationShortcut.NextDocument}" />
        <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding ExecuteShortcutCommand}" CommandParameter="{x:Static enums:ApplicationShortcut.PreviousDocument}" />
    </Window.KeyBindings>

    <Window.Styles>
        <!-- Document tabs used to repeat the object name inside each document's own body -
             once as the doc's Title, again (schema-less) as its FilePath - on top of the
             literal tab strip already showing it. This replaces that with a two-line tab
             header instead: line 1 the database/connection, line 2 schema.objectname (or the
             equivalent for other document types - see IHasTabHeaderLines).

             This targets DocumentControl/MdiDocumentControl, NOT DocumentTabStrip directly -
             confirmed via Dock.Avalonia's own source that both host controls wire their
             internal DocumentTabStrip.HeaderTemplate via TemplateBinding back to their own
             HeaderTemplate property. A TemplateBinding resolves to a local value (even when
             it evaluates to null), which takes precedence over a Style setter on the inner
             DocumentTabStrip - so a DocumentTabStrip-targeted style silently loses. Setting
             HeaderTemplate on the outer control is what actually flows down - confirmed via a
             standalone repro using the real Dock.Model.Mvvm.Controls.DocumentDock/Document
             types nested the same way ShellView's own DockFactory nests them.

             Two separate Style blocks, not one comma-combined selector: a combined selector
             resolves the Setter's target property against the selectors' common base type
             (TemplatedControl), which doesn't have HeaderTemplate and fails to compile.

             The header is now a 2-column Grid: column 0 a fixed-size status icon slot (the
             document itself decides which state applies, via IHasTabHeaderLines.TabIconState -
             plain vector shapes, no image assets/animation, satisfying "not animated"), column 1
             the two-line text stack unchanged from before. The icon naturally spans the full
             row height since it's a sibling column to the whole two-line stack, not an
             overlapping row. -->
        <Style Selector="dock|DocumentControl">
            <Setter Property="HeaderTemplate">
                <DataTemplate DataType="vm:IHasTabHeaderLines">
                    <Grid ColumnDefinitions="16,Auto" Margin="0,2">
                        <Grid Grid.Column="0" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Fill="Orange" IsVisible="{Binding TabIconState, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static enums:DocumentTabIconState.Busy}}"/>
                            <Ellipse Fill="Red" IsVisible="{Binding TabIconState, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static enums:DocumentTabIconState.Error}}"/>
                            <TextBlock Text="✕" FontSize="10" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding TabIconState, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static enums:DocumentTabIconState.Error}}"/>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Text="{Binding TabHeaderLine1}" FontSize="10" Opacity="0.75"/>
                            <TextBlock Text="{Binding TabHeaderLine2}" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </Setter>
        </Style>
        <Style Selector="dock|MdiDocumentControl">
            <Setter Property="HeaderTemplate">
                <DataTemplate DataType="vm:IHasTabHeaderLines">
                    <Grid ColumnDefinitions="16,Auto" Margin="0,2">
                        <Grid Grid.Column="0" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Fill="Orange" IsVisible="{Binding TabIconState, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static enums:DocumentTabIconState.Busy}}"/>
                            <Ellipse Fill="Red" IsVisible="{Binding TabIconState, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static enums:DocumentTabIconState.Error}}"/>
                            <TextBlock Text="✕" FontSize="10" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding TabIconState, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static enums:DocumentTabIconState.Error}}"/>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Text="{Binding TabHeaderLine1}" FontSize="10" Opacity="0.75"/>
                            <TextBlock Text="{Binding TabHeaderLine2}" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </Setter>
        </Style>
    </Window.Styles>
    <!-- Ctrl+Shift+R, Ctrl+Shift+D, and Ctrl+R are wired in code-behind (handledEventsToo)
         rather than as declarative KeyBindings here, since a descendant such as the AvaloniaEdit
         editor or the search results DataGrid can mark the key event Handled before it would
         otherwise bubble up to a Window-level KeyBinding. -->

    <DockPanel>
        <!-- Main menu bar. No actively-maintained, stable ribbon control targeting this
             Avalonia version was found (the available options are pre-1.0/beta packages or a
             commercial suite), so this uses a classic Windows-style menu instead. -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Settings..." Click="OnSettingsClick"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="OnExitClick"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Toggle _Formatting" InputGesture="Ctrl+M" Click="OnToggleFormattingClick"/>
                <MenuItem Header="_Find in Document" InputGesture="Ctrl+F" Click="OnFindClick"/>
                <MenuItem Header="Focus _Search Box" InputGesture="Ctrl+Shift+F" Command="{Binding ExecuteShortcutCommand}" CommandParameter="{x:Static enums:ApplicationShortcut.Find}"/>
                <MenuItem Header="Focus Search _Results" InputGesture="Ctrl+Shift+R" Click="OnFocusSearchResultsClick"/>
                <MenuItem Header="Focus _Documents" InputGesture="Ctrl+Shift+D" Click="OnFocusDocumentsClick"/>
                <Separator/>
                <MenuItem Header="Toggle Results as _Grid" InputGesture="Ctrl+R" Click="OnToggleResultsGridClick"/>
            </MenuItem>
            <MenuItem Header="_Document">
                <MenuItem Header="_Next Document" InputGesture="Ctrl+Tab" Command="{Binding ExecuteShortcutCommand}" CommandParameter="{x:Static enums:ApplicationShortcut.NextDocument}"/>
                <MenuItem Header="_Previous Document" InputGesture="Ctrl+Shift+Tab" Command="{Binding ExecuteShortcutCommand}" CommandParameter="{x:Static enums:ApplicationShortcut.PreviousDocument}"/>
                <Separator/>
                <MenuItem Header="_Close Document" InputGesture="Ctrl+W" Click="OnCloseDocumentClick"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About SqlPhanos..." Click="OnAboutClick"/>
            </MenuItem>
            <!-- Hidden until UpdateCheckService finds a newer release; then this fades in/out
                 (see ShellView.axaml.cs) to draw the eye without being obnoxious about it. -->
            <MenuItem Name="UpdateAvailableMenuItem" Header="_Update Available" Click="OnCheckForUpdateClick" IsVisible="False">
                <MenuItem.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.5"/>
                    </Transitions>
                </MenuItem.Transitions>
            </MenuItem>
        </Menu>

        <!-- Status bar at bottom -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SystemAccentColor}"
                Padding="8,4">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Name="SettingsButton"
                        Content="⚙ Settings"
                        Click="OnSettingsClick"
                        Padding="6,2"
                        FontSize="12"/>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Main content area -->
        <dock:DockControl Layout="{Binding Layout}" />
    </DockPanel>

</Window>

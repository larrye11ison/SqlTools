<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SqlPhanos.ViewModels"
             xmlns:editor="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="SqlPhanos.Views.SqlDocumentView"
             x:DataType="vm:SqlDocumentViewModel">

    <Design.DataContext>
        <vm:SqlDocumentViewModel/>
    </Design.DataContext>

    <UserControl.Styles>
        <!-- The currently-active mode's button is disabled (clicking it would be a no-op),
             but disabled+grayed alone reads as "unavailable" rather than "this is what
             you're looking at" - a heavier border on top makes the active selection obvious.
             This targets a wrapper Border rather than the Button itself: confirmed via a
             standalone repro that Fluent's disabled-button styling forces the button's own
             internal ContentPresenter.BorderBrush to Transparent (thickness gets through,
             brush doesn't), which silently ate a Button-targeted version of this style. -->
        <Style Selector="Border.active">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- Header bar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SystemAccentColor}"
                Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border CornerRadius="4" Classes.active="{Binding IsShowingOriginal}">
                    <Button Command="{Binding ShowOriginalCommand}"
                            Content="Original"
                            IsEnabled="{Binding !IsShowingOriginal}"/>
                </Border>

                <Border CornerRadius="4" Classes.active="{Binding IsShowingFormatted}">
                    <Button Command="{Binding ShowFormattedCommand}"
                            Content="Reformatted"
                            IsEnabled="{Binding !IsShowingFormatted}"/>
                </Border>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top"
                IsVisible="{Binding HasDependentObjects}"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Dependent objects:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           FontSize="12"/>
                <!-- A single scrollable row rather than a WrapPanel, so a wide list of
                     dependent objects never wraps onto a second (vertical-looking) line. -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding DependentObjects}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SearchResultViewModel">
                                <Button Command="{Binding ((vm:SqlDocumentViewModel)DataContext).ScriptDependentObjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Padding="6,2"
                                        FontSize="12"
                                        ToolTip.Tip="Script this dependent object into a new tab">
                                    <TextBlock Text="{Binding ObjectName}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <editor:TextEditor x:Name="Editor"
                           FontSize="16"
                           IsReadOnly="True"
                           ShowLineNumbers="True"
                           WordWrap="False"
                           HorizontalScrollBarVisibility="Auto"
                           VerticalScrollBarVisibility="Auto"/>
    </DockPanel>

</UserControl>

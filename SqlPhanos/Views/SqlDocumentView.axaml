<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SqlPhanos.ViewModels"
             xmlns:editor="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="SqlPhanos.Views.SqlDocumentView"
             x:DataType="vm:SqlDocumentViewModel">

    <Design.DataContext>
        <vm:SqlDocumentViewModel/>
    </Design.DataContext>

    <DockPanel>
        <!-- Header bar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SystemAccentColor}"
                Padding="12,8">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="{Binding Title}"
                           FontWeight="SemiBold"
                           FontSize="14"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Text="{Binding FilePath}"
                           FontSize="11"
                           Opacity="0.7"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="0,10,0,0">
                    <TextBlock Text="View:"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>

                    <Button Command="{Binding ShowOriginalCommand}"
                            Content="Original"
                            IsEnabled="{Binding !IsShowingOriginal}" />

                    <Button Command="{Binding ShowFormattedCommand}"
                            Content="Formatted"
                            IsEnabled="{Binding !IsShowingFormatted}" />

                    <Border Background="#33000000"
                            CornerRadius="4"
                            Padding="8,2">
                        <TextBlock Text="{Binding DisplayModeLabel}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top"
                IsVisible="{Binding HasDependentObjects}"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Dependent objects:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           FontSize="12"/>
                <!-- A single scrollable row rather than a WrapPanel, so a wide list of
                     dependent objects never wraps onto a second (vertical-looking) line. -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding DependentObjects}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SearchResultViewModel">
                                <Button Command="{Binding ((vm:SqlDocumentViewModel)DataContext).ScriptDependentObjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Padding="6,2"
                                        FontSize="12"
                                        ToolTip.Tip="Script this dependent object into a new tab">
                                    <TextBlock Text="{Binding ObjectName}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <editor:TextEditor x:Name="Editor"
                           FontSize="16"
                           IsReadOnly="True"
                           ShowLineNumbers="True"
                           WordWrap="False"
                           HorizontalScrollBarVisibility="Auto"
                           VerticalScrollBarVisibility="Auto"/>
    </DockPanel>

</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SqlPhanos.ViewModels"
             xmlns:editor="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="SqlPhanos.Views.SqlDocumentView"
             x:DataType="vm:SqlDocumentViewModel">

    <Design.DataContext>
        <vm:SqlDocumentViewModel/>
    </Design.DataContext>

    <UserControl.Styles>
        <!-- The active mode is denoted solely by this border, not by disabling/graying out
             the inactive button - both Original and Reformatted stay normally clickable.
             This targets a wrapper Border rather than the Button itself: confirmed via a
             standalone repro that Fluent's disabled-button styling forces the button's own
             internal ContentPresenter.BorderBrush to Transparent (thickness gets through,
             brush doesn't), which silently ate a Button-targeted version of this style - a
             leftover risk even now that IsEnabled isn't toggled here, so the wrapper stays. -->
        <Style Selector="Border.active">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
        </Style>

        <!-- Plain GridSplitter has no background by default, so it renders as literally nothing -
             a divider a user has no reason to know is draggable. A visible bar plus an
             accent-colored hover state gives it the same "yes, drag this" affordance any IDE
             splitter has. -->
        <Style Selector="GridSplitter">
            <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        </Style>
        <Style Selector="GridSplitter:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
        </Style>
    </UserControl.Styles>

    <Grid>
    <DockPanel IsEnabled="{Binding IsContentInteractive}">
        <!-- Scripting-in-progress banner: this document opens immediately (busy tab icon) and
             scripts itself, so this is the only place progress/cancel is shown - the Search
             Results pane that used to own this no longer tracks per-row scripting state. -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding IsScripting}"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Scripting..." VerticalAlignment="Center"/>
                <Button Command="{Binding CancelScriptingCommand}" Content="Cancel"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top"
                IsVisible="{Binding IsInErrorState}"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="Red"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <TextBlock Text="{Binding StatusMessage}" Foreground="IndianRed" TextWrapping="Wrap"/>
        </Border>

        <!-- Header bar -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding !IsScripting}"
                Background="{DynamicResource SystemAccentColor}"
                Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border CornerRadius="4" Classes.active="{Binding IsShowingOriginal}">
                    <Button Command="{Binding ShowOriginalCommand}"
                            Content="Original"/>
                </Border>

                <Border CornerRadius="4" Classes.active="{Binding IsShowingFormatted}">
                    <Button Command="{Binding ShowFormattedCommand}"
                            Content="Reformatted"/>
                </Border>

                <Border Width="1" Margin="4,0" Background="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>

                <Button Command="{Binding RefreshCommand}"
                        Content="Refresh"
                        ToolTip.Tip="Re-script this object from the server"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top"
                IsVisible="{Binding HasDependentObjects}"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Dependent objects:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           FontSize="12"/>
                <!-- A single scrollable row rather than a WrapPanel, so a wide list of
                     dependent objects never wraps onto a second (vertical-looking) line. -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding DependentObjects}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SearchResultViewModel">
                                <Button Command="{Binding ((vm:SqlDocumentViewModel)DataContext).ScriptDependentObjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Padding="6,2"
                                        FontSize="12"
                                        ToolTip.Tip="Script this dependent object into a new tab">
                                    <TextBlock Text="{Binding ObjectName}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Grid x:Name="ContentGrid" RowDefinitions="1*,Auto,3*">
            <editor:TextEditor x:Name="Editor"
                               Grid.Row="0"
                               IsReadOnly="True"
                               ShowLineNumbers="True"
                               WordWrap="False"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"/>

            <GridSplitter Grid.Row="1" Height="6" IsVisible="{Binding IsClrObject}" ResizeDirection="Rows"/>

            <!-- Purely decorative grip dots layered on top of the splitter bar (same Grid cell) -
                 IsHitTestVisible="False" so drag/click still reaches the GridSplitter beneath. -->
            <TextBlock Grid.Row="1"
                       Text="•••"
                       FontSize="10"
                       LineHeight="6"
                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       IsVisible="{Binding IsClrObject}"/>

            <!-- CLR objects only script a thin "AS EXTERNAL NAME" wrapper above - this is the
                 actual decompiled implementation, shown alongside it rather than in place of it.
                 Nested in its own Auto/* grid so the splitter above only ever resizes this whole
                 pane as a unit against the SQL editor - the header inside it stays a fixed size
                 regardless, and only the editor (the "*" row here) absorbs the size change. -->
            <Grid Grid.Row="2" RowDefinitions="Auto,*">
                <Border Grid.Row="0"
                        IsVisible="{Binding IsClrObject}"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        BorderThickness="0,1"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Decompiled CLR implementation:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                        <Button Content="Save As DLL..." Click="OnSaveAsDllClick"/>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="0"
                           IsVisible="{Binding HasClrDecompileError}"
                           Text="{Binding ClrDecompileError}"
                           Foreground="IndianRed"
                           TextWrapping="Wrap"
                           Padding="12,6"/>

                <editor:TextEditor x:Name="ClrEditor"
                                   Grid.Row="1"
                                   IsVisible="{Binding IsClrObject}"
                                   IsReadOnly="True"
                                   ShowLineNumbers="True"
                                   WordWrap="False"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Grid>
    </DockPanel>

    <!-- Encrypted-module decrypt consent overlay - a real security-relevant gate (opens a DAC
         connection, requires sysadmin), shown in-tab rather than as a modal dialog. Mirrors
         ScriptDatabasesDocumentView's identical overlay for the bulk path. -->
    <Grid x:Name="EncryptedConsentOverlay" IsVisible="{Binding PendingEncryptedConsent}" Background="#80000000">
        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="420">
            <StackPanel Spacing="8">
                <TextBlock Text="Encrypted object detected" FontWeight="Bold" FontSize="16"/>
                <TextBlock TextWrapping="Wrap">
                    <Run Text="{Binding PendingEncryptedObjectName}"/>
                    <Run Text=" is encrypted (WITH ENCRYPTION). Decrypting requires opening a Dedicated Administrator Connection (DAC / ADMIN:) and requires sysadmin (or equivalent) - for remote instances, 'remote admin connections' must be enabled. Nothing is altered or dropped on the server."/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
                    <Button x:Name="ConfirmDecryptButton" Command="{Binding ConfirmDecryptCommand}" Content="Decrypt" Classes="accent" IsDefault="True"/>
                    <Button Command="{Binding DeclineDecryptCommand}" Content="Skip"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

    <!-- Formatting safety-check warning overlay: SqlCanonicalizationService re-verifies its own
         output before returning it and falls back to the original, unformatted text rather than
         risk handing back corrupted SQL - see SqlCanonicalizationService.IsRoundTripSafe. This
         must be surfaced, not silently swallowed, so the user knows to report it. -->
    <Grid x:Name="FormattingSafetyWarningOverlay" IsVisible="{Binding PendingFormattingSafetyWarning}" Background="#80000000">
        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="420">
            <StackPanel Spacing="8">
                <TextBlock Text="Formatting was skipped" FontWeight="Bold" FontSize="16"/>
                <TextBlock TextWrapping="Wrap">
                    <Run Text="The formatter's own safety check found that reformatting "/>
                    <Run Text="{Binding SchemaName}"/>
                    <Run Text="."/>
                    <Run Text="{Binding ObjectName}"/>
                    <Run Text=" would not have reproduced the same SQL, so the original, unformatted script is shown instead. Nothing was changed or lost - please report this so the formatter bug can be fixed."/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Command="{Binding DismissFormattingSafetyWarningCommand}" Content="OK" Classes="accent" IsDefault="True"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

    <!-- Closing this tab (X, Ctrl+W, the Close Document menu item) while the object is still
         being scripted would otherwise silently abandon it - see SqlDocumentViewModel.OnClose. -->
    <Grid x:Name="CloseConfirmationOverlay" IsVisible="{Binding PendingCloseConfirmation}" Background="#80000000">
        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="420">
            <StackPanel Spacing="8">
                <TextBlock Text="Scripting is still running" FontWeight="Bold" FontSize="16"/>
                <TextBlock TextWrapping="Wrap"
                           Text="Closing this tab will cancel scripting in progress. Close anyway?"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
                    <Button Command="{Binding ConfirmCloseCommand}" Content="Cancel &amp; Close" Classes="accent"/>
                    <Button Command="{Binding KeepWorkingCommand}" Content="Keep Working" IsDefault="True" IsCancel="True"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>

</UserControl>

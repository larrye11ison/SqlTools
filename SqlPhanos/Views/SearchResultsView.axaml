<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SqlPhanos.ViewModels"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="500"
             x:Class="SqlPhanos.Views.SearchResultsView"
             x:DataType="vm:SearchResultsViewModel">

    <Grid RowDefinitions="Auto,*">
        <!-- Filter controls: stacked vertically since this panel is intentionally narrow.
             General filter gets a full-width row since it's the one most commonly used;
             the four field-specific filters share two compact rows underneath. -->
        <StackPanel Grid.Row="0"
                    Spacing="2"
                    Margin="4"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <TextBox Text="{Binding FilterGeneral}" PlaceholderText="Filter (any field)" Margin="2"/>
            <Grid ColumnDefinitions="*,*">
                <TextBox Grid.Column="0" Text="{Binding FilterName}" PlaceholderText="Name" Margin="2"/>
                <TextBox Grid.Column="1" Text="{Binding FilterSchema}" PlaceholderText="Schema" Margin="2"/>
            </Grid>
            <Grid ColumnDefinitions="*,*">
                <TextBox Grid.Column="0" Text="{Binding FilterDb}" PlaceholderText="DB" Margin="2"/>
                <TextBox Grid.Column="1" Text="{Binding FilterType}" PlaceholderText="Type" Margin="2"/>
            </Grid>
        </StackPanel>

        <!-- Results list: a narrow, vertically-oriented item per result rather than a wide
             columnar grid, since this panel now shares the left dock with Object Search. -->
        <ListBox x:Name="ResultsList"
                 Grid.Row="1"
                 ItemsSource="{Binding FilteredResults}"
                 DoubleTapped="ResultsList_DoubleTapped">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:SearchResultViewModel">
                    <StackPanel Spacing="2" Margin="0,2">
                        <TextBlock Text="{Binding ServerName}"
                                   FontSize="11"
                                   Opacity="0.7"
                                   TextTrimming="CharacterEllipsis"/>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Background="{DynamicResource SystemAccentColor}"
                                    CornerRadius="3"
                                    Padding="4,1">
                                <TextBlock Text="{Binding TypeDesc}" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="Encrypted"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="Orange"
                                       IsVisible="{Binding IsEncrypted}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding FullyQualifiedName}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="{Binding ParentFqName, StringFormat='on {0}'}"
                                   FontSize="11"
                                   Opacity="0.7"
                                   IsVisible="{Binding HasParent}"
                                   TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="4"
                                    HorizontalAlignment="Right"
                                    Margin="0,4,0,0">
                            <Button Content="Script"
                                    Command="{Binding ((vm:SearchResultsViewModel)DataContext).ScriptObjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Padding="6,3"
                                    FontSize="12"/>
                        </StackPanel>

                        <Separator Margin="0,4,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
